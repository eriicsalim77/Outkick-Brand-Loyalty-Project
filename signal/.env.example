# Optional. Without this, the Trending section falls back to a curated set.
# Get a key at https://exa.ai (free tier available). Then copy this file to
# .env.local and paste the key.
EXA_API_KEY=

# Optional. Without this, each live signal's "why this matters" and short
# learning card are generated from templates instead of by Claude Haiku 4.5.
# Get a key at https://console.anthropic.com. Copy this file to .env.local
# and paste the key.
ANTHROPIC_API_KEY=

# Optional. RevenueCat Web Billing SDK public API key (starts with "rcb_"
# or a test key starts with "test_"). NOTE: NEXT_PUBLIC_ prefix is required
# because the SDK runs in the browser. Without this the Upgrade page flips
# a local dev-only flag; nothing charges. Get a key at
# https://app.revenuecat.com — Project Settings → API Keys → Web Billing.
# Also set up an offering with packages: lifetime, yearly, monthly and an
# entitlement id "signal_pro".
NEXT_PUBLIC_RC_WEB_KEY=
